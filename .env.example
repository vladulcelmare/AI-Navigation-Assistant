DB_USER=your-database-username
DB_PASSWORD=your-database-password
DB_SERVER=localhost
DB_PORT=the-port-your-database-is-listening-on
DB_NAME=In_Car_Assistant_DB
DB_DRIVER=ODBC Driver 17 for SQL Server

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

GEOAPIFY_API_KEY=your-geoapify-api-key
GEOAPIFY_URL=https://api.geoapify.com/v1/routing?mode=drive&format=geojson

# Configure both in the same currency: price per litre and per kWh.
FUEL_PRICE=0
ELECTRICITY_PRICE=0
